{
  "name": "aulagestion",
  "version": "0.1.0",
  "private": true,
  "description": "AulaGestión: web SaaS for individual teachers in Costa Rica.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm run lint",
    "db:up": "docker compose --env-file .env up -d postgres",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir db/migrations",
    "db:rollback": "node --env-file-if-exists=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down 1 --migrations-dir db/migrations",
    "db:seed": "node --env-file-if-exists=.env db/seed.ts",
    "test:db": "npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test db/schema.integration.test.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "node-pg-migrate": "9.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
